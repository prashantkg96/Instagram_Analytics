{"nodes": [{"id": "insta_web_analytics_src_index_csp", "label": "Content-Security-Policy (connect-src 'none')", "file_type": "rationale", "source_file": "insta-web-analytics/src/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "connect-src 'none' in the page's CSP is called out in an inline comment as 'the guarantee worth reading twice': the browser itself blocks any network request the page might attempt, so the claim that data never leaves the machine is enforced by the browser rather than merely promised, verifiable via DevTools -> Network showing no entries while processing an export."}, {"id": "insta_web_analytics_src_index_nothing_uploaded", "label": "Nothing is uploaded (feature tile)", "file_type": "concept", "source_file": "insta-web-analytics/src/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "insta_web_analytics_src_index_nothing_stored", "label": "Nothing is stored (feature tile)", "file_type": "concept", "source_file": "insta-web-analytics/src/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "insta_web_analytics_src_index_no_account_access", "label": "No account access (feature tile)", "file_type": "concept", "source_file": "insta-web-analytics/src/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "insta_web_analytics_src_index_media_stays_shut", "label": "Your media stays shut (feature tile)", "file_type": "concept", "source_file": "insta-web-analytics/src/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only the data manifests inside the export are read; about 90% of the archive (photos/videos) is skipped and never opened."}, {"id": "insta_web_analytics_src_index_intake_f