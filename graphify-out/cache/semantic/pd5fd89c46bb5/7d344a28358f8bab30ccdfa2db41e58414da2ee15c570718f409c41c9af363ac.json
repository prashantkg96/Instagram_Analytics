{"nodes": [{"id": "readme_instagram_analytics", "label": "Instagram Analytics (project)", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_insta_web_analytics", "label": "insta-web-analytics (web tool)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses the official Instagram data export (ZIP), needs no credentials and carries no ToS/ban risk, and runs fully offline. Because Meta's export omits like/view counts and story viewers, the tool derives growth from follower join dates instead, and can additionally surface follower join dates, growth attribution, cohorts, ad exposure, off-platform tracking, DM stats, and a privacy audit \u2014 none of which the desktop tool can do."}, {"id": "readme_insta_desktop_analytics", "label": "insta-desktop-analytics (desktop tool)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses Instagram's private API via instagrapi with username+password credentials, which violates Instagram's ToS and risks account bans. In exchange it gets live engagement data unavailable in exports (likes/views, story viewers, giveaways) that the web tool cannot provide."}, {"id": "readme_instagrapi", "label": "instagrapi library", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unofficial third-party library used to access Instagram's private API; using it violates Instagram's ToS and may cause account restrictions or bans, so the app is offered for educational/personal use only, at the user's own risk."}, {"id": "readme_giveaway_winner_picker", "label": "Giveaway Winner Picker", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fetches likers, commenters, and the author's followers for a given post URL, supports intersection filtering, and uses an optional seed so a pick is reproducible."}, {"id": "readme_anti_detection_session_management", "label": "Anti-Detection & Session Management", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Session reuse, background keep-alive pings, randomized human-like delays between API calls, and a 24-hour engagement-frequency warning exist to minimize Instagram's detection and rate-limiting of the unofficial instagrapi client."}, {"id": "readme_privacy_security", "label": "Privacy & Security (credential storage)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Credentials are stored locally only, base64-encoded in UserData/saved_accounts.json, and are never uploaded or shared with any server other than Instagram's own API during login; leaving the Save checkbox unchecked avoids local storage entirely. This is the mechanism that backs the 'credentials never leave your machine' claim for the desktop tool."}, {"id": "readme_login", "label": "Login step", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_scan_followers_following", "label": "Scan Followers & Following step", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_store_in_sqlite", "label": "Store in SQLite step", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_generate_reports", "label": "Generate Reports step", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_scan_engagement", "label": "Scan Engagement step", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_fetch_post_data", "label": "Fetch Post Data step", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_pick_winner", "label": "Pick Winner step", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_profile_photos_caching", "label": "Profile photos caching (circular thumbnails)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "readme_instagram_analytics", "target": "readme_insta_web_analytics", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_instagram_analytics", "target": "readme_insta_desktop_analytics", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_insta_desktop_analytics", "target": "readme_instagrapi", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_insta_desktop_analytics", "target"